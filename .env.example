# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Anon key — CÔNG KHAI, được nhúng vào bundle JS của trình duyệt.
# Cần thiết để mở WebSocket Realtime. Không có key này thì web tự
# động hạ cấp sang polling 5 giây và vẫn chạy bình thường.
# Lấy ở Supabase Dashboard → Settings → API → Project API keys.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# OpenAI Configuration (hoặc bất kỳ OpenAI SDK compatible gateway nào như Vilao, OpenRouter)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.vilao.ai/v1

# Trần thời gian cho 1 lượt gọi LLM (ms). Mặc định 50000, tự kẹp tối đa 55000
# để không vượt maxDuration = 60s của Vercel. Model chậm hơn giá trị này thì
# mọi lượt đều hết hạn và AI rơi về luật cứng — đo bằng `npm run check:llm`.
LLM_TIMEOUT_MS=50000

# Cron Security — đặt cùng một chuỗi ngẫu nhiên (>= 16 ký tự) ở cả 2 nơi:
#   • CRON_SECRET: Vercel tự gắn vào header khi gọi cron.
#   • AI_TICK_SECRET: dùng cho `npm run tick` và GitHub Actions.
CRON_SECRET=
AI_TICK_SECRET=